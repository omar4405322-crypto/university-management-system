# =============================================================================
# UniCore Test Database Environment Configuration Template (.env.test.example)
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.test in the repository root:
#    cp .env.test.example .env.test
# 2. Fill in your desired local test database credentials.
# 3. Start the test container: pnpm run test:db:up
# 4. Deploy migrations to the test database: pnpm run test:db:deploy
# 5. Seed the test database: pnpm run test:db:seed
#
# CRITICAL SAFETY INVARIANT:
# TEST_DATABASE_URL must target a local interface (localhost / 127.0.0.1) unless CI=true.
# The database name MUST end with "_test" or start with "test_".
# It must NEVER match the development or production database name.
# =============================================================================

POSTGRES_USER=unicore_test_user
POSTGRES_PASSWORD=replace_with_test_password
POSTGRES_DB=unicore_test

# Local test connection string consumed by test runners and Prisma
TEST_DATABASE_URL=postgresql://unicore_test_user:replace_with_test_password@localhost:5433/unicore_test?schema=public
