const { PrismaClient } = require('@prisma/client'); 
const p = new PrismaClient(); 

p.user.update({ 
  where: { email: 'superadmin@university.com' }, 
  data: { twoFactorEnabled: false } 
}) 
.then(() => { 
  console.log('Done! 2FA disabled'); 
  p.$disconnect(); 
}) 
.catch(e => { 
  console.error(e); 
  p.$disconnect(); 
});