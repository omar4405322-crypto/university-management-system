# Copy this file to deploy.env. Use URL-safe values without spaces for database credentials.
APP_PORT=8080
PUBLIC_ORIGIN=https://university.example.com

POSTGRES_DB=university
POSTGRES_USER=university
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password

# Generate independently with a cryptographically secure random generator.
JWT_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_64_random_hex_characters

# Optional production integrations.
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
