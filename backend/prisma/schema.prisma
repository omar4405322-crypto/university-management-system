generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is used by Prisma at runtime (goes through PgBouncer, connection_limit=1)
// DIRECT_URL is used by prisma migrate only (direct connection, no pooler)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  password         String
  role             Role           @default(STUDENT)
  adminRole        AdminRole?
  collegeId        Int?           // For COLLEGE_ADMIN
  college          College?       @relation(fields: [collegeId], references: [id])
  departmentId     Int?           // For DEPARTMENT_ADMIN
  department       Department?    @relation(fields: [departmentId], references: [id])

  // For scoped ADMIN users — optional FK to the college they manage
  managedCollegeId Int?
  managedCollege   College?       @relation("ManagedCollege", fields: [managedCollegeId], references: [id])

  // For scoped ADMIN users — optional FK to the department they manage
  managedDepartmentId Int?
  managedDepartment   Department?   @relation("ManagedDepartment", fields: [managedDepartmentId], references: [id])

  profilePicture   String?
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?        // TOTP secret
  tokenVersion     Int            @default(0)
  createdAt        DateTime       @default(now())
  doctor           Doctor?
  student          Student?
  teachingAssistant TeachingAssistant?
  notifications    Notification[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@index([role])
  @@index([email])
}

model RefreshToken { 
  id        Int      @id @default(autoincrement()) 
  token     String   @unique 
  userId    Int 
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) 
  expiresAt DateTime 
  createdAt DateTime @default(now()) 
  @@index([userId]) 
} 

model AuditLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id])
  userEmail      String?
  userRole       String?
  action         String   // e.g., "CREATE_STUDENT", "UPDATE_PAYMENT"
  entity         String   // e.g., "Student", "Payment"
  entityId       String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([timestamp])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

enum NotificationType {
  EXAM_PUBLISHED
  EXAM_ACTIVATED
  QUIZ_PUBLISHED
  SUBMISSION_GRADED
  EXAM_REMINDER
  GENERAL
}

model College {
  id            Int          @id @default(autoincrement())
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  status        String       @default("active")
  logoUrl       String?
  departments   Department[]
  admins        User[]
  // Back relation for scoped ADMIN users who manage a single college
  managedAdmins User[]       @relation("ManagedCollege")
  timetables    Timetable[]
  createdAt     DateTime     @default(now())
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  nameAr      String?
  collegeId   Int
  college     College  @relation(fields: [collegeId], references: [id])
  courses     Course[]
  students    Student[]
  doctors     Doctor[]
  teachingAssistants TeachingAssistant[]
  admins      User[]
  // Back relation for scoped DEPARTMENT_ADMIN users who manage a single department
  managedAdmins User[]       @relation("ManagedDepartment")
  registrationRequests RegistrationRequest[]
  timetables  Timetable[]
  createdAt    DateTime @default(now())

  @@index([collegeId])
}

model RegistrationRequest {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  role         Role
  firstName    String
  lastName     String
  studentId    String?  // For students
  year         Int?     // For students
  phone        String?
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  status       RequestStatus @default(PENDING)
  rejectionReason String?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([email])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Student {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  firstName       String
  lastName        String
  studentId       String   @unique
  year            Int      @default(1)
  phone           String?
  address         String?
  bio             String?
  isActive        Boolean  @default(true)
  gender          String?
  birthDate       DateTime?
  enrolledAt      DateTime @default(now())
  departmentId    Int?
  department      Department?      @relation(fields: [departmentId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  payments        Payment[]
  quizSubmissions QuizSubmission[]
  taskSubmissions TaskSubmission[]
  enrollments     Enrollment[]
  attendance      Attendance[]
  successMetrics  StudentSuccessMetric?
  examSubmissions ExamSubmission[]

  @@index([studentId])
  @@index([departmentId, year])
  @@index([firstName, lastName])
}

model StudentSuccessMetric {
  id                Int      @id @default(autoincrement())
  studentId         Int      @unique
  student           Student  @relation(fields: [studentId], references: [id])
  attendanceRate    Float    @default(0)
  averageQuizScore  Float    @default(0)
  assignmentCompletionRate Float @default(0)
  predictedRisk     RiskLevel @default(LOW)
  lastCalculated    DateTime @default(now())
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  date      DateTime @default(now())
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime @default(now())

  @@index([courseId, date])
  @@index([studentId, courseId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Payment {
  id            Int           @id @default(autoincrement())
  studentId     Int
  student       Student       @relation(fields: [studentId], references: [id])
  amount        Float
  type          PaymentType
  status        PaymentStatus @default(PENDING)
  description   String?
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([studentId, status])
  @@index([createdAt])
}

enum PaymentType {
  TUITION
  REGISTRATION
  LIBRARY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Doctor {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique
  user          User          @relation(fields: [userId], references: [id])
  firstName     String
  lastName      String
  doctorId      String        @unique @default(dbgenerated("'DOC-' || lpad(nextval('doctor_id_seq'::regclass)::text, 5, '0')"))
  phone         String?
  address       String?
  bio           String?
  gender        String?
  birthDate     DateTime?
  specialty     String?
  departmentId  Int?
  department    Department?   @relation(fields: [departmentId], references: [id])
  courses       Course[]
  quizzes       Quiz[]
  tasks         Task[]
  examSessions  ExamSession[]

  @@index([doctorId])
  @@index([departmentId])
}

model TeachingAssistant {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  specialization String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  schedules    Schedule[] @relation("ScheduleAssistant")
}

model Course {
  id            Int           @id @default(autoincrement())
  courseCode    String        @unique
  name          String
  nameAr        String?
  description   String?
  credits       Int           @default(3)
  maxStudents   Int           @default(30)
  year          Int           @default(1)
  semester      Int           @default(1)
  departmentId  Int?
  department    Department?   @relation(fields: [departmentId], references: [id])
  doctorId      Int?
  doctor        Doctor?       @relation(fields: [doctorId], references: [id])
  schedules     Schedule[]
  exams         Exam[]
  quizzes       Quiz[]
  tasks         Task[]
  enrollments   Enrollment[]
  attendance    Attendance[]
  examSessions  ExamSession[]
  createdAt     DateTime      @default(now())

  @@index([courseCode])
  @@index([departmentId])
  @@index([doctorId])
}

model Quiz {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  courseId     Int
  course       Course       @relation(fields: [courseId], references: [id])
  doctorId     Int
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  duration     Int          // in minutes
  startTime    DateTime?
  endTime      DateTime?
  questions    Question[]
  submissions  QuizSubmission[]
  createdAt    DateTime     @default(now())

  @@index([courseId])
}

model Question {
  id               Int          @id @default(autoincrement())
  quizId           Int
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type             QuestionType @default(MCQ)
  text             String
  textAr           String?      // Arabic version of question
  points           Int          @default(1)
  orderIndex       Int          @default(0)

  // MCQ fields
  optionA          String?
  optionB          String?
  optionC          String?
  optionD          String?
  correctAnswer    String?      // "A", "B", "C", "D", or "TRUE"/"FALSE"

  // Legacy field (kept for backward compatibility)
  correct          String?      // deprecated — use correctAnswer

  // Essay / File fields
  maxWords         Int?
  allowedFileTypes String?      // e.g. "pdf,docx"

  quizAnswers      QuizAnswer[]

  @@index([quizId])
}

model QuizSubmission {
  id           Int          @id @default(autoincrement())
  quizId       Int
  quiz         Quiz         @relation(fields: [quizId], references: [id])
  studentId    Int
  student      Student      @relation(fields: [studentId], references: [id])
  answers      Json         // legacy snapshot kept for backward compat
  score        Float?
  needsGrading Boolean      @default(false) // true when Essay/File questions present
  feedback     String?      // doctor's overall feedback
  submittedAt  DateTime     @default(now())
  gradedAt     DateTime?
  quizAnswers  QuizAnswer[]

  @@index([quizId, studentId])
}

// Per-question answer record for manual grading
model QuizAnswer {
  id           Int             @id @default(autoincrement())
  submissionId Int
  submission   QuizSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     Question        @relation(fields: [questionId], references: [id])

  selectedOption String?   // "A"/"B"/"C"/"D" or "TRUE"/"FALSE"
  essayText      String?   // Written answer
  fileUrl        String?   // Uploaded file URL

  score          Float?
  feedback       String?   // Per-question feedback from doctor
  isCorrect      Boolean?
  gradedAt       DateTime?

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id])
  doctorId    Int
  doctor      Doctor    @relation(fields: [doctorId], references: [id])
  dueDate     DateTime
  maxScore    Int       @default(100)
  submissions TaskSubmission[]
  createdAt   DateTime  @default(now())

  @@index([courseId])
}

model TaskSubmission {
  id          Int      @id @default(autoincrement())
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id])
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  fileUrl     String?
  notes       String?
  score       Float?
  submittedAt DateTime @default(now())

  @@index([taskId, studentId])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  dayOfWeek String   // "Sunday", "Monday", etc.
  startTime String   // "09:00"
  endTime   String   // "11:00"
  room      String?
  assistantId Int?
  assistant TeachingAssistant? @relation("ScheduleAssistant", fields: [assistantId], references: [id])
  createdAt DateTime @default(now())

  @@index([courseId])
}

model Timetable {
  id           Int        @id @default(autoincrement())
  collegeId    Int
  college      College    @relation(fields: [collegeId], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  academicYear Int        // Study Level: 1, 2, 3, 4, etc.
  semester     Int        // 1 or 2
  title        String
  description  String?
  scheduleData Json?      // JSON for dynamic schedule slots
  fileUrl      String?    // If they prefer uploading a PDF/Image
  status       TimetableStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([collegeId, departmentId, academicYear, semester])
  @@index([collegeId, departmentId])
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
}

model Exam {
  id          Int          @id @default(autoincrement())
  courseId    Int
  course      Course       @relation(fields: [courseId], references: [id])
  type        ExamType     @default(MIDTERM)
  date        DateTime
  startTime   String
  endTime     String
  room        String?
  createdAt   DateTime     @default(now())
  examSession ExamSession?

  @@index([courseId, date])
}

enum ExamType {
  MIDTERM
  FINAL
  QUIZ
}

enum Role {
  STUDENT
  DOCTOR
  TEACHING_ASSISTANT
  ADMIN
  COLLEGE_ADMIN
  DEPARTMENT_ADMIN
  SUPER_ADMIN
}

enum AdminRole {
  IT_SUPPORT
  REGISTRAR
  FINANCE
  ACADEMIC_DEAN
}

model Enrollment {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     Int
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester     Int
  academicYear Int
  finalGrade   Float?
  status       EnrollmentStatus @default(ENROLLED)
  enrolledAt   DateTime @default(now())

  @@unique([studentId, courseId, semester, academicYear])
  @@index([studentId])
  @@index([courseId])
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  WITHDRAWN
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// Online Exam System
// ─────────────────────────────────────────────────────────────────────────────

enum QuestionType {
  MCQ         // Multiple choice (A/B/C/D)
  TRUE_FALSE  // True or False
  ESSAY       // Written answer
  FILE_UPLOAD // Student uploads a file
}

enum ExamSessionStatus {
  DRAFT     // Not published yet
  PUBLISHED // Visible to students
  ACTIVE    // Currently open for submissions
  CLOSED    // No more submissions
  GRADED    // All submissions graded
}

enum SubmissionStatus {
  IN_PROGRESS // Student started but not submitted
  SUBMITTED   // Student submitted
  GRADED      // Doctor graded this submission
  LATE        // Submitted after deadline
}

enum ViolationType {
  TAB_SWITCH      // User switched to another tab/window
  WINDOW_BLUR     // Browser window lost focus
  COPY_ATTEMPT    // User tried to copy text
  PASTE_ATTEMPT   // User tried to paste
  RIGHT_CLICK     // User right-clicked
  DEVTOOLS_OPEN   // DevTools detected
  FULLSCREEN_EXIT // User exited fullscreen
  FOCUS_LOST      // Page visibility changed to hidden
}

// ExamSession — links an Exam schedule entry to an actual online exam
model ExamSession {
  id               Int               @id @default(autoincrement())
  examId           Int               @unique  // Links to existing Exam schedule
  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  courseId         Int
  course           Course            @relation(fields: [courseId], references: [id])
  doctorId         Int
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  title            String
  instructions     String?
  durationMinutes  Int               // Time limit in minutes
  totalPoints      Int               @default(100)
  passingScore     Float             @default(50)
  shuffleQuestions Boolean           @default(false)
  showResultsAfter Boolean           @default(true) // Show results to student after submission
  allowedAttempts  Int               @default(1)
  status           ExamSessionStatus @default(DRAFT)
  opensAt          DateTime?         // When students can start
  closesAt         DateTime?         // Hard deadline
  questions        ExamQuestion[]
  submissions      ExamSubmission[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([courseId])
  @@index([doctorId])
  @@index([status])
}

// ExamQuestion — supports MCQ, True/False, Essay, File Upload
model ExamQuestion {
  id               Int          @id @default(autoincrement())
  examSessionId    Int
  examSession      ExamSession  @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  type             QuestionType
  text             String       // Question body (supports Arabic)
  textAr           String?      // Arabic version of question
  points           Int          @default(1)
  orderIndex       Int          @default(0) // Question order

  // MCQ fields (only used when type = MCQ)
  optionA          String?
  optionB          String?
  optionC          String?
  optionD          String?
  correctAnswer    String?      // "A", "B", "C", "D", or "TRUE"/"FALSE"

  // Essay / File fields
  maxWords         Int?         // Max words for essay
  allowedFileTypes String?      // e.g. "pdf,docx" for file upload questions

  answers          ExamAnswer[]

  @@index([examSessionId, orderIndex])
}

// ExamSubmission — one per student per ExamSession
model ExamSubmission {
  id            Int              @id @default(autoincrement())
  examSessionId Int
  examSession   ExamSession      @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  studentId     Int
  student       Student          @relation(fields: [studentId], references: [id])
  status        SubmissionStatus @default(IN_PROGRESS)
  startedAt     DateTime         @default(now())
  submittedAt   DateTime?
  totalScore    Float?           // Set after grading
  feedback      String?          // Doctor's overall feedback
  violationCount Int             @default(0)  // incremented on each violation
  answers       ExamAnswer[]
  violations    ExamViolation[]

  @@unique([examSessionId, studentId]) // One submission per student per exam
  @@index([examSessionId])
  @@index([studentId])
}

// ExamAnswer — student's answer to each question
model ExamAnswer {
  id             Int            @id @default(autoincrement())
  submissionId   Int
  submission     ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId     Int
  question       ExamQuestion   @relation(fields: [questionId], references: [id])

  // The answer content (only one will be filled based on question type)
  selectedOption String?        // "A", "B", "C", "D", "TRUE", "FALSE" for MCQ/TF
  essayText      String?        // Written answer for ESSAY type
  fileUrl        String?        // Cloudinary URL for FILE_UPLOAD type
  fileKey        String?        // Cloudinary public_id for deletion

  // Grading (auto for MCQ/TF, manual for Essay/File)
  score          Float?
  feedback       String?        // Per-question feedback from doctor
  isCorrect      Boolean?       // Auto-set for MCQ/TF
  gradedAt       DateTime?

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

// ExamViolation — anti-cheat log for each detected integrity issue
model ExamViolation {
  id            Int            @id @default(autoincrement())
  submissionId  Int
  submission    ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type          ViolationType
  detectedAt    DateTime       @default(now())
  metadata      Json?          // extra info: { tabUrl, count, etc. }

  @@index([submissionId])
  @@index([type])
}
