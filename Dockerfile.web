FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.34.4 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY artifacts/university-app/package.json ./artifacts/university-app/
COPY lib/api-client-react/package.json ./lib/api-client-react/

RUN pnpm install --frozen-lockfile --strict-peer-dependencies=false

COPY artifacts/university-app/ ./artifacts/university-app/
COPY lib/api-client-react/tsconfig.json ./lib/api-client-react/
COPY lib/api-client-react/src/ ./lib/api-client-react/src/

ARG VITE_BACKEND_URL=/api
ARG BASE_PATH=/
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
ENV BASE_PATH=${BASE_PATH}
ENV NODE_ENV=production

RUN pnpm --filter @workspace/university-app run build

FROM nginx:1.27-alpine AS runner

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/artifacts/university-app/dist/public/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1
