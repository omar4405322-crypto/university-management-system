import React, { useState, useEffect } from 'react';
import { useTranslation } from 'react-i18next';
import { useSearchParams } from 'react-router-dom';
import { useAuth } from '../../context/AuthContext';
import useScope from '../../hooks/useScope';
import { AlertCircle, CheckCircle, Plus, Loader2, BookOpen, User, MapPin, X, Beaker, Users, MonitorPlay, Printer } from 'lucide-react';
import departmentService from '../../services/department.service';
import coursesService from '../../services/courses.service';
import doctorsService from '../../services/doctors.service';
import timetableService from '../../services/timetable.service';

const DAYS = ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'];
const TIME_SLOTS = ['08:00-10:00', '10:00-12:00', '12:00-14:00', '14:00-16:00', '16:00-18:00'];
const YEARS = ['1', '2', '3', '4', '5'];
const SEMS = ['1', '2'];

const DAY_COLORS = {
  Saturday:  'bg-blue-50 dark:bg-blue-900/10 border-blue-200 dark:border-blue-700/30',
  Sunday:    'bg-purple-50 dark:bg-purple-900/10 border-purple-200 dark:border-purple-700/30',
  Monday:    'bg-green-50 dark:bg-green-900/10 border-green-200 dark:border-green-700/30',
  Tuesday:   'bg-yellow-50 dark:bg-yellow-900/10 border-yellow-200 dark:border-yellow-700/30',
  Wednesday: 'bg-orange-50 dark:bg-orange-900/10 border-orange-200 dark:border-orange-700/30',
  Thursday:  'bg-red-50 dark:bg-red-900/10 border-red-200 dark:border-red-700/30',
};

const TimetableGrid = () => {
  const { t, i18n } = useTranslation();
  const { user } = useAuth();
  const { scope, isCollegeAdmin } = useScope();
  const isRTL = i18n.language?.startsWith('ar');
  const [searchParams] = useSearchParams();

  const [selectedDept, setSelectedDept] = useState(searchParams.get('dept') || '');
  const [selectedYear, setSelectedYear] = useState(searchParams.get('year') || '1');
  const [selectedSem, setSelectedSem] = useState(searchParams.get('sem') || '1');
  const [slots, setSlots] = useState({});
  const [dialog, setDialog] = useState(null);
  const [form, setForm] = useState({ courseName: '', doctorName: '', room: '' });
  const [departments, setDepartments] = useState([]);
  const [loadingDepts, setLoadingDepts] = useState(false);
  const [courses, setCourses] = useState([]);
  const [loadingCourses, setLoadingCourses] = useState(false);
  const [doctors, setDoctors] = useState([]);
  const [loadingSlots, setLoadingSlots] = useState(false);
  const [saving, setSaving] = useState(false);
  const [toast, setToast] = useState(null);

  const showToast = (message, type) => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3000);
  };

  const collegeId = user?.managedCollegeId || user?.collegeId || scope?.collegeId;
  const deptId = user?.managedDepartmentId || user?.departmentId || scope?.departmentId;

  useEffect(() => {
    setLoadingDepts(true);
    const params = {};
    if (collegeId) params.collegeId = collegeId;

    departmentService.getDepartments(params)
      .then(res => {
        if (res.success) {
          const depts = res.data || [];
          setDepartments(depts);
          if (user?.role === 'DEPARTMENT_ADMIN') {
            if (depts.length === 1) setSelectedDept(String(depts[0].id));
            else if (deptId) setSelectedDept(String(deptId));
          }
        } else {
          showToast(res.message || t('common.errorOccurred'), 'error');
        }
      })
      .catch(console.error)
      .finally(() => setLoadingDepts(false));
  }, [collegeId, deptId, user?.role, t]);

  useEffect(() => {
    if (!selectedDept || !selectedYear || !selectedSem) return;
    setLoadingSlots(true);
    
    timetableService.getTimetables({ departmentId: selectedDept, academicYear: selectedYear, semester: selectedSem })
      .then(res => {
        const timetable = res.data?.timetables?.[0] || res.data?.[0];
        if (timetable?.scheduleData?.slots) {
          const mapped = {};
          timetable.scheduleData.slots.forEach(slot => {
            const key = `${slot.day}_${slot.startTime}-${slot.endTime}`;
            mapped[key] = {
              courseName: slot.courseName,
              doctorName: slot.instructor,
              room: slot.room,
              sessionType: slot.sessionType || 'LECTURE',
              timetableId: timetable.id
            };
          });
          setSlots(mapped);
        } else {
          setSlots({});
        }
      })
      .catch(console.error)
      .finally(() => setLoadingSlots(false));
  }, [selectedDept, selectedYear, selectedSem]);

  useEffect(() => {
    if (!selectedDept) {
      setCourses([]);
      return;
    }
    setLoadingCourses(true);
    
    Promise.all([
      coursesService.getCourses({ departmentId: selectedDept }),
      doctorsService.getDoctors({ limit: 1000 })
    ])
      .then(([coursesRes, doctorsRes]) => {
        if (coursesRes.success) {
          const coursesArray = Array.isArray(coursesRes.data)
            ? coursesRes.data
            : coursesRes.data?.data?.courses || coursesRes.data?.courses || coursesRes.data?.data || [];
          setCourses(coursesArray);
        }
        if (doctorsRes.success) {
          const docsArray = Array.isArray(doctorsRes.data)
            ? doctorsRes.data
            : doctorsRes.data?.doctors || doctorsRes.data?.data?.doctors || doctorsRes.data?.data || [];
          setDoctors(docsArray);
        }
      })
      .catch(console.error)
      .finally(() => setLoadingCourses(false));
  }, [selectedDept]);

  const filteredDepts = departments;

  const openAdd = (day, slot) => {
    setForm({ courseName: '', doctorName: '', room: '', sessionType: 'LECTURE' });
    setDialog({ day, slot });
  };

  const openEdit = (day, slot) => {
    setForm(slots[`${day}_${slot}`]);
    setDialog({ day, slot });
  };

  const saveSlot = () => {
    if (!form.courseName) return;
    
    const newKey = `${dialog.day}_${dialog.slot}`;
    
    // Check time conflict: same day, overlapping slot, different cell
    const conflict = Object.entries(slots).find(([key, val]) => {
      if (key === newKey) return false;
      const [slotDay] = key.split('_');
      return slotDay === dialog.day && val.courseName === form.courseName;
    });
    
    if (conflict) {
      showToast(t('timetables.duplicateError', `Warning: Course "${form.courseName}" is already scheduled on this day!`), 'error');
      return;
    }
    
    setSlots(prev => ({ ...prev, [newKey]: form }));
    setDialog(null);
  };

  const deleteSlot = (day, slot) => {
    if (!window.confirm(t('timetables.deleteConfirm', 'Are you sure you want to delete this class slot?'))) return;
    setSlots(prev => { 
      const n = { ...prev }; 
      delete n[`${day}_${slot}`]; 
      return n; 
    });
  };

  const handleSaveTimetable = async () => {
    if (!selectedDept || !selectedYear || !selectedSem) {
      showToast(t('timetables.selectRequired', 'Please select department, year, and semester'), 'error');
      return;
    }
    setSaving(true);
    try {
      const slotsArray = Object.entries(slots).map(([key, val]) => {
        const [day, time] = key.split('_');
        const [startTime, endTime] = time.split('-');
        return { 
          day, 
          startTime, 
          endTime, 
          courseName: val.courseName, 
          instructor: val.doctorName, 
          room: val.room,
          sessionType: val.sessionType || 'LECTURE'
        };
      });

      const dept = departments.find(d => String(d.id) === String(selectedDept));
      const collegeId = dept?.collegeId || scope?.collegeId;

      const payload = {
        collegeId: parseInt(collegeId),
        departmentId: parseInt(selectedDept),
        academicYear: parseInt(selectedYear),
        semester: parseInt(selectedSem),
        title: `${t('timetables.title', 'Timetable')} - ${t('common.year', 'Year')} ${selectedYear} - ${t('timetables.semester', 'Semester')} ${selectedSem}`,
        scheduleData: { slots: slotsArray }
      };

      // Check if timetable already exists
      const existing = await timetableService.getTimetables({ 
        departmentId: selectedDept, 
        academicYear: selectedYear, 
        semester: selectedSem 
      });
      
      const existingId = existing?.data?.timetables?.[0]?.id || existing?.data?.[0]?.id || existing?.[0]?.id;
      
      if (existingId) {
        await timetableService.updateTimetable(existingId, payload);
      } else {
        await timetableService.createTimetable(payload);
      }
      showToast(t('timetables.saveSuccess', 'Timetable saved successfully ✅'), 'success');
    } catch (err) {
      showToast(t('common.errorOccurred', 'Error saving timetable ❌'), 'error');
      console.error(err);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="section-gap animate-in fade-in duration-500">
      {/* Toast Notification */}
      {toast && (
        <div className={`${toast.type === 'error' ? 'toast-error' : 'toast-success'}`}>
          <div className="flex items-center gap-2">
            {toast.type === 'error' ? <AlertCircle size={18} /> : <CheckCircle size={18} />}
            <span className="font-medium">{toast.message}</span>
          </div>
        </div>
      )}

      {/* Filter Bar */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 flex-wrap">
        <div className="flex items-center gap-4 flex-wrap flex-1">
          <select 
            className="w-full md:w-56 h-11 px-4 bg-brand-bg-card border border-brand-border rounded-xl text-sm font-semibold text-brand-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary-500/20 focus:border-brand-primary-500 transition-all appearance-none cursor-pointer disabled:opacity-50" 
            value={selectedDept} 
            onChange={e => setSelectedDept(e.target.value)}
            disabled={user?.role === 'DEPARTMENT_ADMIN'}
          >
            <option value="">{loadingDepts ? t('common.loading', 'Loading...') : t('timetables.selectDept', 'Select Department')}</option>
            {departments.map(d => <option key={d.id} value={d.id}>{d.name}</option>)}
          </select>

          <select 
            className="w-full md:w-36 h-11 px-4 bg-brand-bg-card border border-brand-border rounded-xl text-sm font-semibold text-brand-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary-500/20 focus:border-brand-primary-500 transition-all appearance-none cursor-pointer" 
            value={selectedYear} 
            onChange={e => setSelectedYear(e.target.value)}
          >
            {YEARS.map(y => <option key={y} value={y}>{t('common.year', 'Year')} {y}</option>)}
          </select>

          <select 
            className="w-full md:w-36 h-11 px-4 bg-brand-bg-card border border-brand-border rounded-xl text-sm font-semibold text-brand-text-primary focus:outline-none focus:ring-2 focus:ring-brand-primary-500/20 focus:border-brand-primary-500 transition-all appearance-none cursor-pointer" 
            value={selectedSem} 
            onChange={e => setSelectedSem(e.target.value)}
          >
            {SEMS.map(s => <option key={s} value={s}>{t('timetables.semester', 'Semester')} {s}</option>)}
          </select>
        </div>

        <div className="flex items-center gap-3">
          <button 
            onClick={() => window.print()}
            className="print:hidden px-4 py-2.5 bg-brand-bg-card hover:bg-surface-subtle border border-brand-border text-brand-text-primary font-black text-xs uppercase tracking-widest rounded-xl transition-all flex items-center gap-2"
          >
            <Printer size={16} />
            {t('common.print', 'Print')}
          </button>

          <button 
            onClick={handleSaveTimetable} 
            disabled={saving || loadingSlots}
            className="print:hidden px-6 py-2.5 bg-brand-primary-500 hover:bg-brand-primary-600 disabled:opacity-50 text-white font-black text-xs uppercase tracking-widest rounded-xl transition-all shadow-md flex items-center gap-2"
          >
            {saving && <Loader2 size={16} className="animate-spin" />}
            {t('common.save', 'Save Timetable')}
          </button>
        </div>
      </div>

      {/* Grid Container */}
      <div className="bg-brand-bg-card border border-brand-border rounded-2xl shadow-soft overflow-hidden relative">
        {loadingSlots && (
          <div className="absolute inset-0 bg-brand-bg-card/70 backdrop-blur-sm z-10 flex items-center justify-center">
            <Loader2 size={40} className="animate-spin text-brand-primary-500" />
          </div>
        )}

        <div className="overflow-x-auto">
          <table className="w-full table-fixed border-collapse border-0">
            <thead>
              <tr className="bg-surface-subtle border-b border-brand-border">
                <th className={`w-32 p-4 font-black uppercase text-xs tracking-widest text-brand-text-muted border-r border-brand-border ${isRTL ? 'text-right' : 'text-left'}`}>
                  {t('timetables.startTime', 'Time')}
                </th>
                {DAYS.map(day => (
                  <th key={day} className="p-4 text-center font-black uppercase text-xs tracking-widest text-brand-text-muted border-r border-brand-border last:border-r-0">
                    {t(`days.${day.toLowerCase()}`, day)}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {TIME_SLOTS.map((slot, sIdx) => (
                <tr key={slot} className="border-b border-brand-border last:border-b-0 hover:bg-surface-subtle/30 transition-colors">
                  <td className={`p-4 font-black text-xs text-brand-text-primary border-r border-brand-border ${isRTL ? 'text-right' : 'text-left'}`}>
                    {slot}
                  </td>
                  {DAYS.map(day => {
                    const key = `${day}_${slot}`;
                    const entry = slots[key];
                    return (
                      <td key={key} className="p-3 border-r border-brand-border last:border-r-0 min-h-[100px] align-top">
                        {entry ? (
                          <div className={`rounded-xl p-3 text-xs space-y-2 border transition-all shadow-sm ${
                            entry.sessionType === 'LAB' ? 'bg-green-50 border-green-200 dark:bg-green-900/10 dark:border-green-700/30' :
                            entry.sessionType === 'SEMINAR' ? 'bg-purple-50 border-purple-200 dark:bg-purple-900/10 dark:border-purple-700/30' :
                            'bg-blue-50 border-blue-200 dark:bg-blue-900/10 dark:border-blue-700/30'
                          } relative group`}>
                            <button 
                              onClick={() => deleteSlot(day, slot)} 
                              className={`absolute top-2 ${isRTL ? 'left-2' : 'right-2'} p-1 text-brand-text-muted hover:text-rose-500 bg-white/50 hover:bg-rose-50 rounded-lg transition-all opacity-0 group-hover:opacity-100`}
                              title={t('common.delete', 'Delete')}
                            >
                              <X size={14} />
                            </button>
                            <p className={`font-black text-brand-text-main tracking-tight line-clamp-2 ${isRTL ? 'pl-6' : 'pr-6'} flex items-start gap-1.5`}>
                              <BookOpen size={14} className="mt-0.5 shrink-0 text-brand-primary-500" />
                              {entry.courseName}
                            </p>
                            <p className="font-bold text-brand-text-sub flex items-center gap-1.5">
                              <User size={12} className="text-brand-text-muted shrink-0" />
                              <span className="opacity-75 truncate">{entry.doctorName || t('common.staff', 'Staff')}</span>
                            </p>
                            <p className="font-bold text-brand-text-muted flex items-center gap-1.5">
                              <MapPin size={12} className="shrink-0" />
                              <span className="uppercase tracking-wider truncate">{entry.room || t('common.tba', 'TBA')}</span>
                            </p>
                            <div className="pt-2 flex justify-between items-center border-t border-brand-border/40">
                              <span className="text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-md bg-white/50 border border-brand-border/50 flex items-center gap-1">
                                {entry.sessionType === 'LAB' ? <Beaker size={10} /> : 
                                 entry.sessionType === 'SEMINAR' ? <Users size={10} /> : 
                                 <MonitorPlay size={10} />}
                                {t(`schedule.${(entry.sessionType || 'LECTURE').toLowerCase()}`, entry.sessionType || 'LECTURE')}
                              </span>
                              <button onClick={() => openEdit(day, slot)} className="text-brand-primary-500 hover:text-brand-primary-600 font-black text-[10px] uppercase tracking-wider transition-colors shrink-0">
                                {t('common.edit', 'Edit')}
                              </button>
                            </div>
                          </div>
                        ) : (
                          <button 
                            onClick={() => openAdd(day, slot)} 
                            disabled={!selectedDept}
                            className="w-full h-20 flex items-center justify-center text-brand-text-muted/30 hover:text-brand-primary-500 hover:bg-brand-primary-500/5 hover:border-brand-primary-500/30 border-2 border-dashed border-brand-border rounded-xl transition-all text-xl font-bold disabled:opacity-30 disabled:pointer-events-none"
                          >
                            <Plus size={20} />
                          </button>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Dialog */}
      {dialog && (
        <div className="fixed inset-0 bg-brand-navy-500/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-in fade-in duration-200">
          <div className="bg-brand-bg-card border border-brand-border rounded-2xl p-6 w-full max-w-sm shadow-2xl space-y-5 animate-in zoom-in-95 duration-200">
            
            <div className="text-center space-y-1 pb-3 border-b border-brand-border">
              <h3 className="font-black text-brand-text-primary text-xl tracking-tight flex items-center justify-center gap-2">
                <BookOpen size={20} className="text-brand-primary-500" />
                {form.courseName ? t('common.edit', 'Edit') : t('schedule.addSlot', 'Add Slot')}
              </h3>
              <p className="text-sm font-bold text-brand-text-muted">
                {t(`days.${dialog.day.toLowerCase()}`)} • {dialog.slot}
              </p>
            </div>

            <div className="space-y-4">
              <div className="space-y-1.5">
                <label className="text-[10px] font-black text-brand-text-muted uppercase tracking-widest ml-1">{t('courses.course', 'Course')} *</label>
                <select
                  className="w-full h-11 px-4 bg-brand-bg-page/50 border border-brand-border rounded-xl text-sm font-bold text-brand-text-main focus:outline-none focus:ring-2 focus:ring-brand-primary-500/20 focus:border-brand-primary-500 transition-all cursor-pointer"
                  value={form.courseName}
                  onChange={e => {
                    const course = courses.find(c => c.name === e.target.value);
                    setForm(p => ({
                      ...p,
                      courseName: e.target.value,
                      doctorName: course?.doctor
                        ? `${course.doctor.firstName || ''} ${course.doctor.lastName || ''}`.trim()
                        : p.doctorName
                    }));
                  }}
                >
                  <option value="">{loadingCourses ? t('common.loading', 'Loading...') : t('schedule.selectCourse', 'Select Course')}</option>
                  {courses.map(c => (
                    <option key={c.id} value={c.name}>{c.name} - {c.courseCode}</option>
                  ))}
                </select>
              </div>

              <div className="space-y-1.5">
                <label className="text-[10px] font-black text-brand-text-muted uppercase tracking-widest ml-1">{t('timetables.instructor', 'Instructor')}</label>
                <div className="relative">
                  <User size={16} className={`absolute ${isRTL ? 'right-3' : 'left-3'} top-1/2 -translate-y-1/2 text-brand-text-muted`} />
                  {doctors.length === 0 ? (
                    <select disabled className={`w-full h-11 ${isRTL ? 'pr-10 pl-4' : 'pl-10 pr-4'} bg-brand-bg-page/50 border border-brand-border rounded-xl text-sm font-bold text-brand-text-muted opacity-50`}>
                      <option>لا يوجد أساتذة مسجلون</option>
                    </select>
                  ) : (
                    <select 
                      className={`w-full h-11 ${isRTL ? 'pr-10 pl-4' : 'pl-10 pr-4'} bg-brand-bg-page/50 border border-brand-border rounded-xl text-sm font-bold text-brand-text-main focus:outline-none focus:ring-2 focus:ring-brand-primary-500/20 focus:border-brand-primary-500 transition-all cursor-pointer`}
                      value={form.doctorName}
                      onChange={e => setForm(p => ({ ...p, doctorName: e.target.value }))}
                    >
                      <option value="">{t('timetables.selectProfessor', 'Select Professor')}</option>
                      {doctors.map(doc => {
                        const isDifferentCollege = doc.department?.collegeId && String(doc.department.collegeId) !== String(collegeId);
                        const docName = `${doc.firstName || ''} ${doc.lastName || ''}`.trim();
                        return (
                          <option key={doc.id} value={docName} className={isDifferentCollege ? "text-amber-600 font-bold" : ""}>
                            {docName} {isDifferentCollege ? "⚠️ (كلية أخرى)" : ""}
                          </option>
                        );
                      })}
                    </select>
                  )}
                </div>
              </div>

              <div className="space-y-1.5">
                <label className="text-[10px] font-black text-brand-text-muted uppercase tracking-widest ml-1">{t('timetables.room', 'Room')} *</label>
                <div className="relative">
                  <MapPin size={16} className={`absolute ${isRTL ? 'right-3' : 'left-3'} top-1/2 -translate-y-1/2 text-brand-text-muted`} />
                  <input 
                    className={`w-full h-11 ${isRTL ? 'pr-10 pl-4' : 'pl-10 pr-4'} bg-brand-bg-page/50 border border-brand-border rounded-xl text-sm font-bold text-brand-text-main focus:outline-none focus:ring-2 focus:ring-brand-primary-500/20 focus:border-brand-primary-500 transition-all`} 
                    placeholder={t('schedule.roomPlaceholder', 'e.g. A101')} 
                    value={form.room} 
                    onChange={e => setForm(p => ({ ...p, room: e.target.value }))} 
                  />
                </div>
              </div>

              <div className="space-y-1.5">
                <label className="text-[10px] font-black text-brand-text-muted uppercase tracking-widest ml-1">{t('schedule.sessionType', 'Session Type')}</label>
                <div className="grid grid-cols-3 gap-2">
                  {['LECTURE', 'LAB', 'SEMINAR'].map(type => (
                    <button
                      key={type}
                      onClick={() => setForm(p => ({ ...p, sessionType: type }))}
                      className={`h-10 text-xs font-black uppercase tracking-wider rounded-xl transition-all border ${
                        form.sessionType === type 
                          ? 'bg-brand-primary-500 text-white border-brand-primary-500 shadow-md shadow-brand-primary-500/20' 
                          : 'bg-brand-bg-page/50 text-brand-text-secondary border-brand-border hover:bg-brand-navy/5'
                      }`}
                    >
                      {t(`schedule.${type.toLowerCase()}`, type)}
                    </button>
                  ))}
                </div>
              </div>

              <div className="flex gap-3 justify-end pt-4 border-t border-brand-border">
                <button 
                  onClick={() => setDialog(null)} 
                  className="px-4 py-2 text-brand-text-secondary hover:bg-brand-navy/5 rounded-xl text-xs font-black uppercase tracking-widest transition-colors flex-1"
                >
                  {t('common.cancel', 'Cancel')}
                </button>
                <button 
                  onClick={saveSlot} 
                  className="px-5 py-2.5 bg-brand-green hover:bg-[#16a34a] text-white font-black rounded-xl text-xs uppercase tracking-widest transition-colors shadow-md shadow-brand-green/20 flex-[2]"
                >
                  <Plus size={16} className={`inline-block ${isRTL ? 'ml-1' : 'mr-1'} -mt-0.5`} />
                  {form.courseName ? t('common.save', 'Save') : t('schedule.addSlot', 'Add Slot')}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default TimetableGrid;