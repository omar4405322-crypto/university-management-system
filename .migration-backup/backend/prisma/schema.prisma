generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  COLLEGE_ADMIN
  DEPARTMENT_ADMIN
  DOCTOR
  STUDENT
  SUPER_ADMIN
  TEACHING_ASSISTANT
}

enum AdminRole {
  ACADEMIC_DEAN
  FINANCE
  IT_SUPPORT
  REGISTRAR
}

enum RequestStatus {
  APPROVED
  PENDING
  REJECTED
}

enum RiskLevel {
  CRITICAL
  HIGH
  LOW
  MEDIUM
}

enum AttendanceStatus {
  ABSENT
  EXCUSED
  LATE
  PRESENT
}

enum AttendanceMethod {
  MANUAL
  QR
  RFID
}

enum PaymentType {
  LIBRARY
  OTHER
  REGISTRATION
  TUITION
}

enum PaymentStatus {
  CANCELLED
  OVERDUE
  PAID
  PENDING
}

enum ExamType {
  FINAL
  MIDTERM
  QUIZ
}

enum ExamQuestionType {
  MCQ
  SHORT_ANSWER
  TRUE_FALSE
}

enum ExamSubmissionStatus {
  GRADED
  PENDING
}

enum ExamViolationType {
  BLUR
  COPY_PASTE
  FULLSCREEN_EXIT
  RIGHT_CLICK
  TAB_SWITCH
}

enum MaterialType {
  LECTURE
  TUTORIAL
}

enum EnrollmentStatus {
  BLOCKED
  COMPLETED
  ENROLLED
  FAILED
  WITHDRAWN
}

enum ScheduleRequestType {
  DELETE_SLOT
  NEW_SLOT
  OVERRIDE
  UPDATE_SLOT
}

enum SlotType {
  LAB
  LECTURE
  SECTION
}

enum TAStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                 Int               @id @default(autoincrement())
  email              String            @unique
  password           String
  role               Role              @default(STUDENT)
  adminRole          AdminRole?
  createdAt          DateTime          @default(now())
  profilePicture     String?
  collegeId          Int?
  departmentId       Int?
  tokenVersion       Int               @default(0)
  twoFactorEnabled   Boolean           @default(false)
  twoFactorSecret    String?
  managedCollegeId   Int?
  managedDepartmentId Int?
  deactivatedAt      DateTime?
  isActive           Boolean           @default(true)

  college            College?          @relation("CollegeUsers", fields: [collegeId], references: [id])
  department         Department?       @relation("DepartmentUsers", fields: [departmentId], references: [id])
  managedCollege     College?          @relation("ManagedCollege", fields: [managedCollegeId], references: [id])
  managedDepartment  Department?       @relation("ManagedDepartment", fields: [managedDepartmentId], references: [id])
  doctor             Doctor?
  student            Student?
  teachingAssistant  TeachingAssistant?
  notifications      Notification[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  uploadedMaterials  CourseMaterial[]  @relation("MaterialUploader")
  resolvedRequests   ScheduleChangeRequest[] @relation("RequestResolver")
  requestedRequests  ScheduleChangeRequest[] @relation("RequestRequester")
  createdOverrides   ScheduleOverride[]
  recordedAttendances Attendance[]

  @@index([role])
  @@index([email])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        Int       @id @default(autoincrement())
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id])
  userEmail String?
  userRole  String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime  @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([timestamp])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model College {
  id             Int          @id @default(autoincrement())
  name           String
  nameAr         String?
  description    String?
  createdAt      DateTime     @default(now())
  descriptionAr  String?

  collegeDepts   Department[] @relation("CollegeDepartment")
  admins         User[]       @relation("CollegeUsers")
  managedAdmins  User[]       @relation("ManagedCollege")
  timetables     Timetable[]
}

model Department {
  id                  Int       @id @default(autoincrement())
  name                String
  nameAr              String?
  collegeId           Int
  college             College   @relation("CollegeDepartment", fields: [collegeId], references: [id])
  createdAt           DateTime  @default(now())

  courses             Course[]
  students            Student[]
  doctors             Doctor[]
  teachingAssistants  TeachingAssistant[]
  admins              User[]            @relation("DepartmentUsers")
  managedAdmins       User[]            @relation("ManagedDepartment")
  registrationRequests RegistrationRequest[]
  timetables          Timetable[]
  studentGroups       StudentGroup[]
  absencePolicies     AbsenceThresholdPolicy[]
  scheduleChangeReqs  ScheduleChangeRequest[]

  @@index([collegeId])
}

model RegistrationRequest {
  id              Int           @id @default(autoincrement())
  email           String        @unique
  password        String
  role            Role
  firstName       String
  lastName        String
  studentId       String?
  year            Int?
  phone           String?
  departmentId    Int?
  department      Department?   @relation(fields: [departmentId], references: [id])
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())

  @@index([status])
  @@index([email])
}

model Student {
  id           Int                @id @default(autoincrement())
  userId       Int                @unique
  user         User               @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  studentId    String             @unique
  year         Int                @default(1)
  phone        String?
  address      String?
  bio          String?
  isActive     Boolean            @default(true)
  gender       String?
  birthDate    DateTime?
  enrolledAt   DateTime           @default(now())
  departmentId Int?
  department   Department?        @relation(fields: [departmentId], references: [id])
  groupId      Int?
  studentGroup StudentGroup?      @relation(fields: [groupId], references: [id])
  rfidTag      String?

  payments         Payment[]
  quizSubmissions  QuizSubmission[]
  taskSubmissions  TaskSubmission[]
  enrollments      Enrollment[]
  attendance       Attendance[]
  successMetrics   StudentSuccessMetric?
  examSubmissions  ExamSubmission[]

  @@index([studentId])
  @@index([departmentId, year])
  @@index([firstName, lastName])
}

model StudentSuccessMetric {
  id                     Int       @id @default(autoincrement())
  studentId              Int       @unique
  student                Student   @relation(fields: [studentId], references: [id])
  attendanceRate         Float     @default(0)
  averageQuizScore       Float     @default(0)
  assignmentCompletionRate Float   @default(0)
  predictedRisk          RiskLevel @default(LOW)
  lastCalculated         DateTime  @default(now())
}

model Attendance {
  id               Int                  @id @default(autoincrement())
  studentId        Int
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         Int
  course           Course               @relation(fields: [courseId], references: [id])
  date             DateTime             @default(now())
  status           AttendanceStatus     @default(PRESENT)
  remarks          String?
  createdAt        DateTime             @default(now())
  recordedById     Int?
  recordedBy       User?                @relation(fields: [recordedById], references: [id])
  academicYear     Int?
  semester         Int?
  deviceId         String?
  ipAddress        String?
  locationData     Json?
  locationFlagged  Boolean              @default(false)
  method           AttendanceMethod     @default(MANUAL)
  overriddenBy     String?
  overrideNote     String?
  scheduleSlotId   Int?
  scheduleSlot     ScheduleSlot?        @relation(fields: [scheduleSlotId], references: [id])
  sessionId        Int?
  attendanceSession AttendanceSession?  @relation(fields: [sessionId], references: [id])

  @@unique([studentId, courseId, date])
  @@index([courseId, date])
  @@index([studentId, courseId])
  @@index([scheduleSlotId])
  @@index([sessionId])
}

model AttendanceSession {
  id                       Int          @id @default(autoincrement())
  scheduleSlotId           Int
  scheduleSlot             ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)
  doctorId                 Int?
  doctor                   Doctor?      @relation(fields: [doctorId], references: [id])
  isActive                 Boolean      @default(true)
  secretKey                String
  latitude                 Float?
  longitude                Float?
  radius                   Float?       @default(120)
  createdAt                DateTime     @default(now())
  expiresAt                DateTime
  gracePeriodMins          Int          @default(15)
  codeStepSeconds          Int          @default(20)
  facultyCapturedLatitude  Float?
  facultyCapturedLongitude Float?
  roomMismatchWarning      Boolean      @default(false)

  attendances  Attendance[]

  @@index([scheduleSlotId])
  @@index([doctorId])
  @@index([isActive, expiresAt])
}

model Payment {
  id          Int           @id @default(autoincrement())
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  type        PaymentType
  status      PaymentStatus @default(PENDING)
  description String?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([studentId, status])
  @@index([createdAt])
}

model Doctor {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  doctorId     String     @unique @default(dbgenerated("'DOC-' || lpad(nextval('doctor_id_seq'::regclass)::text, 5, '0')"))
  phone        String?
  address      String?
  bio          String?
  gender       String?
  birthDate    DateTime?
  specialty    String?
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  courses      Course[]
  quizzes      Quiz[]
  tasks        Task[]
  attendanceSessions   AttendanceSession[]
  scheduleOverrides    ScheduleOverride[]
  scheduleSlots        ScheduleSlot[]

  @@index([doctorId])
  @@index([departmentId])
}

model TeachingAssistant {
  id           String     @id
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  employeeId   String
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  specialization String?
  status       TAStatus   @default(ACTIVE)
  joinedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  firstName    String     @default("TA")
  lastName     String     @default("Staff")

  scheduleSlots      ScheduleSlot[]
  scheduleOverrides  ScheduleOverride[]

  @@index([departmentId])
}

model Course {
  id           Int         @id @default(autoincrement())
  courseCode   String      @unique
  name         String
  description  String?
  credits      Int         @default(3)
  maxStudents  Int         @default(30)
  year         Int         @default(1)
  semester     Int         @default(1)
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  doctorId     Int?
  doctor       Doctor?     @relation(fields: [doctorId], references: [id])
  createdAt    DateTime    @default(now())
  isPublished  Boolean     @default(true)

  schedules    Schedule[]
  exams        Exam[]
  quizzes      Quiz[]
  tasks        Task[]
  enrollments  Enrollment[]
  attendance   Attendance[]
  materials    CourseMaterial[]
  absencePolicies AbsenceThresholdPolicy[]
  scheduleSlots    ScheduleSlot[]
  scheduleChangeRequests ScheduleChangeRequest[]

  @@index([courseCode])
  @@index([departmentId])
  @@index([doctorId])
}

model Room {
  id        Int       @id @default(autoincrement())
  name      String
  latitude  Float?
  longitude Float?
  radius    Int       @default(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rfidDevices RfidDevice[]
  slots       ScheduleSlot[]

  @@unique([name])
}

model RfidDevice {
  id         Int       @id @default(autoincrement())
  roomId     String
  room       Room      @relation(fields: [roomId], references: [name])
  secretHash String
  label      String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
}

model AbsenceThresholdPolicy {
  id               Int      @id @default(autoincrement())
  departmentId     Int?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseId         Int?
  course           Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  maxAbsencePercent Float   @default(25)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([departmentId, courseId])
}

model CourseMaterial {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  type         MaterialType @default(LECTURE)
  fileUrl      String
  fileName     String?
  fileSize     Int?
  fileType     String?
  courseId     Int
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedById Int
  uploadedBy   User         @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  isPublished  Boolean      @default(true)

  @@index([courseId])
  @@index([uploadedById])
  @@index([type])
}

model Quiz {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  courseId     Int
  course       Course     @relation(fields: [courseId], references: [id])
  doctorId     Int
  doctor       Doctor     @relation(fields: [doctorId], references: [id])
  duration     Int
  startTime    DateTime?
  endTime      DateTime?
  questions    Question[]
  submissions  QuizSubmission[]
  createdAt    DateTime   @default(now())

  @@index([courseId])
}

model Question {
  id      Int    @id @default(autoincrement())
  quizId  Int
  quiz    Quiz   @relation(fields: [quizId], references: [id])
  text    String
  optionA String
  optionB String
  optionC String
  optionD String
  correct String
  points  Int    @default(1)

  @@index([quizId])
}

model QuizSubmission {
  id          Int      @id @default(autoincrement())
  quizId      Int
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     Json
  score       Float?
  submittedAt DateTime @default(now())

  @@index([quizId, studentId])
}

model Task {
  id          Int             @id @default(autoincrement())
  title       String
  description String
  courseId    Int
  course      Course          @relation(fields: [courseId], references: [id])
  doctorId    Int
  doctor      Doctor          @relation(fields: [doctorId], references: [id])
  dueDate     DateTime
  maxScore    Int             @default(100)
  submissions TaskSubmission[]
  createdAt   DateTime        @default(now())

  @@index([courseId])
}

model TaskSubmission {
  id          Int      @id @default(autoincrement())
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id])
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl     String?
  notes       String?
  score       Float?
  submittedAt DateTime @default(now())

  @@index([taskId, studentId])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  dayOfWeek String
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())

  @@index([courseId])
}

model StudentGroup {
  id             Int        @id @default(autoincrement())
  name           String
  departmentId   Int
  department     Department @relation(fields: [departmentId], references: [id])
  createdAt      DateTime   @default(now())
  parentGroupId  Int?
  parentGroup    StudentGroup? @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  rangeEndName   String     @default("")
  rangeStartName String     @default("")
  year           Int        @default(1)

  children  StudentGroup[] @relation("GroupHierarchy")
  students  Student[]
  slots     ScheduleSlot[]

  @@index([departmentId, year])
}

model Timetable {
  id           Int             @id @default(autoincrement())
  collegeId    Int
  college      College         @relation(fields: [collegeId], references: [id])
  departmentId Int
  department   Department      @relation(fields: [departmentId], references: [id])
  academicYear Int
  semester     Int
  title        String
  description  String?
  scheduleData Json?
  fileUrl      String?
  status       TimetableStatus @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  slots        ScheduleSlot[]

  @@unique([collegeId, departmentId, academicYear, semester])
  @@index([collegeId, departmentId])
}

model ScheduleSlot {
  id                  Int        @id @default(autoincrement())
  timetableId         Int?
  timetable           Timetable? @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek           String
  startTime           String
  endTime             String
  room                String?
  teachingAssistantId String?
  courseId            Int
  course              Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  doctorId            Int?
  doctor              Doctor?    @relation(fields: [doctorId], references: [id])
  groupId             Int?
  studentGroup        StudentGroup? @relation(fields: [groupId], references: [id])
  slotType            SlotType
  roomId              Int?
  roomRef             Room?      @relation(fields: [roomId], references: [id])
  teachingAssistant   TeachingAssistant? @relation(fields: [teachingAssistantId], references: [id])

  attendanceSessions   AttendanceSession[]
  attendances          Attendance[]
  scheduleOverrides    ScheduleOverride[]
  scheduleChangeRequests ScheduleChangeRequest[]

  @@index([timetableId])
  @@index([courseId])
  @@index([doctorId])
  @@index([groupId])
  @@index([roomId])
}

model ScheduleOverride {
  id                  Int       @id @default(autoincrement())
  scheduleSlotId      Int
  scheduleSlot        ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)
  startDate           DateTime
  endDate             DateTime
  room                String?
  dayOfWeek           String?
  startTime           String?
  endTime             String?
  doctorId            Int?
  doctor              Doctor?   @relation(fields: [doctorId], references: [id])
  teachingAssistantId String?
  teachingAssistant   TeachingAssistant? @relation(fields: [teachingAssistantId], references: [id])
  reason              String?
  createdBy           Int
  creator             User      @relation(fields: [createdBy], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([scheduleSlotId])
  @@index([doctorId])
  @@index([startDate, endDate])
}

model ScheduleChangeRequest {
  id             Int                @id @default(autoincrement())
  type           ScheduleRequestType
  status         RequestStatus      @default(PENDING)
  requesterId    Int
  requester      User               @relation("RequestRequester", fields: [requesterId], references: [id])
  scheduleSlotId Int?
  scheduleSlot   ScheduleSlot?      @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)
  proposedData   Json
  reason         String?
  adminComment   String?
  resolvedById   Int?
  resolver       User?              @relation("RequestResolver", fields: [resolvedById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  courseId       Int
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  departmentId   Int?
  department     Department?        @relation(fields: [departmentId], references: [id])

  @@index([status])
  @@index([requesterId])
  @@index([courseId])
  @@index([scheduleSlotId])
}

model Exam {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  type      ExamType @default(MIDTERM)
  date      DateTime
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())
  durationMinutes Int @default(120)
  title     String?

  questions ExamQuestion[]
  submissions ExamSubmission[]

  @@index([courseId, date])
}

model ExamQuestion {
  id             Int              @id @default(autoincrement())
  examId         Int
  exam           Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  text           String
  type           ExamQuestionType @default(MCQ)
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  correctAnswer  String
  points         Int              @default(1)
  order          Int              @default(1)

  @@index([examId])
  @@index([examId, order])
}

model ExamSubmission {
  id           Int                  @id @default(autoincrement())
  examId       Int
  exam         Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      Json
  score        Float?
  maxScore     Float                @default(0)
  status       ExamSubmissionStatus @default(PENDING)
  antiCheatLogs Json?
  startedAt    DateTime             @default(now())
  submittedAt  DateTime?

  violations ExamViolation[]

  @@index([examId, studentId])
  @@index([status])
}

model ExamViolation {
  id           Int               @id @default(autoincrement())
  submissionId Int
  submission   ExamSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         ExamViolationType
  occurredAt   DateTime          @default(now())
  details      String?

  @@index([submissionId])
  @@index([type])
}

model Enrollment {
  id           Int              @id @default(autoincrement())
  studentId    Int
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     Int
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester     Int
  academicYear Int
  finalGrade   Float?
  status       EnrollmentStatus @default(ENROLLED)
  enrolledAt   DateTime         @default(now())

  @@unique([studentId, courseId, semester, academicYear])
  @@index([studentId])
  @@index([courseId])
}
