# Environment Configuration Example
# Copy to .env and configure appropriate values for your environment.

NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_db?schema=public"

# Authentication & Security
JWT_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
REQUIRE_2FA=false

# Allowed Origins for CORS (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Master Symmetric Encryption Key (AES-256-GCM)
# Required for encrypting sensitive secrets at rest (e.g., RFID device signing keys, User 2FA secrets, AttendanceSession secret keys).
# Format: 32 bytes represented as either:
#   - 64-character hexadecimal string (e.g. generated via `openssl rand -hex 32`)
#   - 44-character base64 string (e.g. generated via `openssl rand -base64 32`)
ENCRYPTION_KEY=REPLACE_ME_WITH_64_RANDOM_HEX_CHARACTERS

# Redis (Optional in local development; required in production for anti-replay ledger and rate limits)
# REDIS_URL=redis://localhost:6379

# Cloudinary Storage (Optional in development, required in production for uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
